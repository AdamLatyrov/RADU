<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\radu.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="commands.default.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\radu.ico" Link="radu.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
