<Window
  x:Class="Radu.Wpf.AccentColorPickerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Свой цвет"
  Width="520"
  Height="460"
  WindowStyle="None"
  ResizeMode="NoResize"
  AllowsTransparency="True"
  Background="Transparent"
  Foreground="{StaticResource TextBrush}"
  FontFamily="Segoe UI Variable Text"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False">
  <Border
    Background="{StaticResource WindowBackgroundBrush}"
    BorderBrush="{StaticResource BorderBrushSoft}"
    BorderThickness="1"
    CornerRadius="8"
    ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="58" />
        <RowDefinition Height="*" />
        <RowDefinition Height="68" />
      </Grid.RowDefinitions>
      <Grid
        Grid.Row="0"
        Background="{StaticResource PanelBrush}"
        MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <StackPanel VerticalAlignment="Center" Margin="18,0,56,0">
          <TextBlock Text="Выбери цвет" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Перетащи указатель по палитре" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
        </StackPanel>
        <Button
          Width="38"
          Height="38"
          Padding="0"
          Margin="0,0,10,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Click="CloseButton_Click"
          ToolTip="Закрыть"
          AutomationProperties.Name="Закрыть выбор цвета">
          <Path
            Width="15"
            Height="15"
            Stretch="Uniform"
            Stroke="{StaticResource MutedBrush}"
            StrokeThickness="1.7"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round"
            Data="{StaticResource ClearIconGeometry}" />
        </Button>
      </Grid>
      <Grid Grid.Row="1" Margin="20,18,20,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="236" />
          <RowDefinition Height="14" />
          <RowDefinition Height="52" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>
          <Border
            Grid.Column="0"
            Width="236"
            Height="236"
            HorizontalAlignment="Center"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="4"
            ClipToBounds="True">
            <Grid
              x:Name="SaturationValuePalette"
              SizeChanged="Palette_SizeChanged"
              Background="Transparent"
              PreviewMouseLeftButtonDown="SaturationValuePalette_MouseLeftButtonDown"
              PreviewMouseMove="SaturationValuePalette_MouseMove"
              PreviewMouseLeftButtonUp="SaturationValuePalette_MouseLeftButtonUp">
              <Rectangle x:Name="HueColorLayer" />
              <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#FF000000" Offset="1" />
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="SaturationThumbOuter" Width="18" Height="18" Stroke="#DD111416" StrokeThickness="3" Fill="Transparent" />
                <Ellipse x:Name="SaturationThumbInner" Width="12" Height="12" Stroke="White" StrokeThickness="1.5" Fill="Transparent" />
              </Canvas>
            </Grid>
          </Border>
          <Border
            Grid.Column="2"
            CornerRadius="3"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            ClipToBounds="True">
            <Grid
              x:Name="HuePalette"
              SizeChanged="Palette_SizeChanged"
              PreviewMouseLeftButtonDown="HuePalette_MouseLeftButtonDown"
              PreviewMouseMove="HuePalette_MouseMove"
              PreviewMouseLeftButtonUp="HuePalette_MouseLeftButtonUp">
              <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#FFFF0000" Offset="0" />
                  <GradientStop Color="#FFFF00FF" Offset="0.1667" />
                  <GradientStop Color="#FF0000FF" Offset="0.3333" />
                  <GradientStop Color="#FF00FFFF" Offset="0.5" />
                  <GradientStop Color="#FF00FF00" Offset="0.6667" />
                  <GradientStop Color="#FFFFFF00" Offset="0.8333" />
                  <GradientStop Color="#FFFF0000" Offset="1" />
                </LinearGradientBrush>
              </Grid.Background>
              <Canvas IsHitTestVisible="False">
                <Border
                  x:Name="HueThumb"
                  Width="26"
                  Height="5"
                  Background="White"
                  BorderBrush="#DD111416"
                  BorderThickness="1"
                  CornerRadius="2" />
              </Canvas>
            </Grid>
          </Border>
          <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border
              x:Name="ColorPreview"
              Width="64"
              Height="64"
              BorderBrush="{StaticResource BorderBrushSoft}"
              BorderThickness="1"
              CornerRadius="4" />
            <TextBlock Text="Выбранный" HorizontalAlignment="Center" Margin="0,9,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}" />
            <TextBlock x:Name="CurrentHex" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="10" FontWeight="SemiBold" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="122" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="HEX" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" />
          <TextBox
            x:Name="HexInput"
            Grid.Column="2"
            Height="42"
            Padding="9,0"
            VerticalContentAlignment="Center"
            MaxLength="7"
            TextChanged="HexInput_TextChanged"
            AutomationProperties.Name="Цвет в формате HEX" />
          <TextBlock
            x:Name="ValidationText"
            Grid.Column="4"
            Text="Можно ввести код HEX вручную"
            VerticalAlignment="Center"
            FontSize="10"
            Foreground="{StaticResource MutedBrush}"
            TextWrapping="Wrap" />
        </Grid>
      </Grid>
      <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
        <Grid Margin="20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="Отмена" Height="40" IsCancel="True" Click="CancelButton_Click" />
          <Button Grid.Column="2" Content="Готово" Height="40" IsDefault="True" BorderBrush="{DynamicResource AccentBrush}" Click="ApplyButton_Click" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
