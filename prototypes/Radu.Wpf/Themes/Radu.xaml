  <SolidColorBrush x:Key="DangerBrush">#FFFF6874</SolidColorBrush>
  <Color
    x:Key="BorderColor">#FF30373D</Color>
  <Color
    x:Key="TextColor">#FFF4F5F7</Color>
  <SolidColorBrush
    x:Key="PanelBrush">#FF171B1E</SolidColorBrush>
  <SolidColorBrush
    x:Key="SurfaceBrush">#FF111416</SolidColorBrush>
  <Style
    TargetType="TextBox"
    x:Key="{x:Type TextBox}">
    <Style.Resources>
      <ResourceDictionary />
    </Style.Resources>
    <Setter
      Property="TextElement.Foreground">
      <Setter.Value>
        <SolidColorBrush>#FFF4F5F7</SolidColorBrush>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Panel.Background">
      <Setter.Value>
        <SolidColorBrush>#FF171B1E</SolidColorBrush>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Border.BorderBrush">
      <Setter.Value>
        <SolidColorBrush>#FF30373D</SolidColorBrush>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Border.BorderThickness">
      <Setter.Value>
        <Thickness>1,1,1,1</Thickness>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Control.Padding">
      <Setter.Value>
        <Thickness>8,8,8,8</Thickness>
      </Setter.Value>
    </Setter>
    <Setter
      Property="TextElement.FontSize">
      <Setter.Value>
        <s:Double>14</s:Double>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Control.Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="TextBox">
          <Border
            BorderThickness="{TemplateBinding Border.BorderThickness}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            BorderBrush="{TemplateBinding Border.BorderBrush}"
            Background="{TemplateBinding Panel.Background}"
            Name="TextBoxSurface">
            <ScrollViewer
              Name="PART_ContentHost"
              Margin="{TemplateBinding Control.Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="UIElement.IsKeyboardFocused">
              <Setter
                Property="Border.BorderBrush"
                TargetName="TextBoxSurface">
                <Setter.Value>
                  <DynamicResource ResourceKey="AccentBrush" />
                </Setter.Value>
              </Setter>
              <Trigger.Value>
                <s:Boolean>True</s:Boolean>
              </Trigger.Value>
            </Trigger>
            <Trigger
              Property="UIElement.IsMouseOver">
              <Setter
                Property="Border.BorderBrush"
                TargetName="TextBoxSurface">
                <Setter.Value>
                  <SolidColorBrush>#FF47515F</SolidColorBrush>
                </Setter.Value>
              </Setter>
              <Trigger.Value>
                <s:Boolean>True</s:Boolean>
              </Trigger.Value>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <SolidColorBrush
    x:Key="TextBrush">#FFF4F5F7</SolidColorBrush>
  <Style
    TargetType="Button"
    x:Key="{x:Type Button}">
    <Style.Resources>
      <ResourceDictionary />
    </Style.Resources>
    <Setter
      Property="TextElement.Foreground">
      <Setter.Value>
        <SolidColorBrush>#FFF4F5F7</SolidColorBrush>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Panel.Background">
      <Setter.Value>
        <SolidColorBrush>#FF171B1E</SolidColorBrush>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Border.BorderBrush">
      <Setter.Value>
        <SolidColorBrush>#FF30373D</SolidColorBrush>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Border.BorderThickness">
      <Setter.Value>
        <Thickness>1,1,1,1</Thickness>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Control.Padding">
      <Setter.Value>
        <Thickness>16,11,16,11</Thickness>
      </Setter.Value>
    </Setter>
    <Setter
      Property="TextElement.FontSize">
      <Setter.Value>
        <s:Double>14</s:Double>
      </Setter.Value>
    </Setter>
    <Setter
      Property="FrameworkElement.Cursor">
      <Setter.Value>
        <Cursor>Hand</Cursor>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Control.Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="Button">
          <Border
            BorderThickness="{TemplateBinding Border.BorderThickness}"
            CornerRadius="{StaticResource CardCornerRadius}"
            BorderBrush="{TemplateBinding Border.BorderBrush}"
            Background="{TemplateBinding Panel.Background}"
            Name="ButtonSurface">
            <ContentPresenter
              Content="{TemplateBinding ContentControl.Content}"
              ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
              ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}"
              Margin="{TemplateBinding Control.Padding}"
              HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
              VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="UIElement.IsMouseOver">
              <Setter
                Property="Border.BorderBrush"
                TargetName="ButtonSurface">
                <Setter.Value>
                  <SolidColorBrush>#FF47515F</SolidColorBrush>
                </Setter.Value>
              </Setter>
              <Setter
                Property="UIElement.Opacity"
                TargetName="ButtonSurface">
                <Setter.Value>
                  <s:Double>0.96</s:Double>
                </Setter.Value>
              </Setter>
              <Trigger.Value>
                <s:Boolean>True</s:Boolean>
              </Trigger.Value>
            </Trigger>
            <Trigger
              Property="ButtonBase.IsPressed">
              <Setter
                Property="Border.BorderBrush"
                TargetName="ButtonSurface">
                <Setter.Value>
                  <DynamicResource ResourceKey="AccentBrush" />
                </Setter.Value>
              </Setter>
              <Setter
                Property="UIElement.Opacity"
                TargetName="ButtonSurface">
                <Setter.Value>
                  <s:Double>0.82</s:Double>
                </Setter.Value>
              </Setter>
              <Trigger.Value>
                <s:Boolean>True</s:Boolean>
              </Trigger.Value>
            </Trigger>
            <Trigger
              Property="UIElement.IsKeyboardFocused">
              <Setter
                Property="Border.BorderBrush"
                TargetName="ButtonSurface">
                <Setter.Value>
                  <DynamicResource ResourceKey="AccentBrush" />
                </Setter.Value>
              </Setter>
              <Trigger.Value>
                <s:Boolean>True</s:Boolean>
              </Trigger.Value>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <SolidColorBrush
    x:Key="BorderBrushSoft">#FF30373D</SolidColorBrush>
  <Color
    x:Key="PanelColor">#FF171B1E</Color>
  <SolidColorBrush
    x:Key="AccentBrush">#FFE8A33D</SolidColorBrush>
  <Color
    x:Key="AccentColor">#FFE8A33D</Color>
  <Color
    x:Key="SurfaceColor">#FF111416</Color>
  <Style
    TargetType="ScrollBar"
    x:Key="{x:Type ScrollBar}">
    <Style.Resources>
      <ResourceDictionary />
    </Style.Resources>
    <Setter
      Property="FrameworkElement.Width">
      <Setter.Value>
        <s:Double>8</s:Double>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Panel.Background">
      <Setter.Value>
        <SolidColorBrush>#00FFFFFF</SolidColorBrush>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Control.Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="ScrollBar">
          <Grid
            Background="#00FFFFFF"
            SnapsToDevicePixels="True">
            <Border Width="3" HorizontalAlignment="Center" CornerRadius="2" Background="#FF252B30" IsHitTestVisible="False" />
            <Track
              Orientation="{TemplateBinding ScrollBar.Orientation}"
              Minimum="{TemplateBinding RangeBase.Minimum}"
              Maximum="{TemplateBinding RangeBase.Maximum}"
              Value="{TemplateBinding RangeBase.Value}"
              ViewportSize="{TemplateBinding ScrollBar.ViewportSize}"
              IsDirectionReversed="True"
              Name="PART_Track">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate
                      TargetType="Thumb">
                      <Border
                        MinHeight="32"
                        CornerRadius="4"
                        Background="#FF59636D"
                        Name="ThumbSurface"
                        Margin="2,1,2,1" />
                      <ControlTemplate.Triggers>
                        <Trigger
                          Property="UIElement.IsMouseOver">
                          <Setter
                            Property="Panel.Background"
                            TargetName="ThumbSurface">
                            <Setter.Value>
                            <DynamicResource ResourceKey="AccentBrush" />
                            </Setter.Value>
                          </Setter>
                          <Trigger.Value>
                            <s:Boolean>True</s:Boolean>
                          </Trigger.Value>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style
    TargetType="ComboBox"
    x:Key="{x:Type ComboBox}">
    <Style.Resources>
      <ResourceDictionary />
    </Style.Resources>
    <Setter
      Property="TextElement.Foreground">
      <Setter.Value>
        <SolidColorBrush>#FFF4F5F7</SolidColorBrush>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Panel.Background">
      <Setter.Value>
        <SolidColorBrush>#FF171B1E</SolidColorBrush>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Border.BorderBrush">
      <Setter.Value>
        <SolidColorBrush>#FF30373D</SolidColorBrush>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Border.BorderThickness">
      <Setter.Value>
        <Thickness>1,1,1,1</Thickness>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Control.Padding">
      <Setter.Value>
        <Thickness>12,9,12,9</Thickness>
      </Setter.Value>
    </Setter>
    <Setter
      Property="TextElement.FontSize">
      <Setter.Value>
        <s:Double>14</s:Double>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Control.Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="ComboBox">
          <Grid>
            <Border
              BorderThickness="{TemplateBinding Border.BorderThickness}"
              CornerRadius="{StaticResource ControlCornerRadius}"
              BorderBrush="{TemplateBinding Border.BorderBrush}"
              Background="{TemplateBinding Panel.Background}"
              Name="ComboSurface"
              IsHitTestVisible="False">
              <Grid>
                <ContentPresenter
                  Content="{TemplateBinding ComboBox.SelectionBoxItem}"
                  Margin="{TemplateBinding Control.Padding}"
                  VerticalAlignment="Center" />
                <Path
                  Data="M1,1L5,5 9,1"
                  Stretch="Fill"
                  Stroke="#FFA7ADB3"
                  StrokeThickness="1.5"
                  Width="10"
                  Height="6"
                  Margin="0,0,14,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ToggleButton
              IsChecked="False"
              BorderThickness="0,0,0,0"
              Background="#00FFFFFF"
              Focusable="False">
              <ToggleButton.Template>
                <ControlTemplate
                  TargetType="ToggleButton">
                  <Border
                    Background="{TemplateBinding Panel.Background}" />
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup
              IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}"
              Placement="Bottom"
              PopupAnimation="Fade"
              AllowsTransparency="True"
              Name="PART_Popup"
              Focusable="False">
              <Border
                BorderThickness="1,1,1,1"
                Padding="5,5,5,5"
                CornerRadius="{StaticResource ControlCornerRadius}"
                BorderBrush="#FF30373D"
                Background="#FF171B1E"
                MinWidth="0">
                <ScrollViewer
                  CanContentScroll="True"
                  MaxHeight="240">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger
              Property="UIElement.IsMouseOver">
              <Setter
                Property="Border.BorderBrush"
                TargetName="ComboSurface">
                <Setter.Value>
                  <SolidColorBrush>#FF47515F</SolidColorBrush>
                </Setter.Value>
              </Setter>
              <Trigger.Value>
                <s:Boolean>True</s:Boolean>
              </Trigger.Value>
            </Trigger>
            <Trigger
              Property="UIElement.IsKeyboardFocusWithin">
              <Setter
                Property="Border.BorderBrush"
                TargetName="ComboSurface">
                <Setter.Value>
                  <DynamicResource ResourceKey="AccentBrush" />
                </Setter.Value>
              </Setter>
              <Trigger.Value>
                <s:Boolean>True</s:Boolean>
              </Trigger.Value>
            </Trigger>
            <Trigger
              Property="ComboBox.IsDropDownOpen">
              <Setter
                Property="Border.BorderBrush"
                TargetName="ComboSurface">
                <Setter.Value>
                  <DynamicResource ResourceKey="AccentBrush" />
                </Setter.Value>
              </Setter>
              <Trigger.Value>
                <s:Boolean>True</s:Boolean>
              </Trigger.Value>
            </Trigger>
            <Trigger
              Property="UIElement.IsEnabled">
              <Setter
                Property="UIElement.Opacity">
                <Setter.Value>
                  <s:Double>0.55</s:Double>
                </Setter.Value>
              </Setter>
              <Trigger.Value>
                <s:Boolean>False</s:Boolean>
              </Trigger.Value>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Color
    x:Key="MutedColor">#FFA7ADB3</Color>
  <SolidColorBrush
    x:Key="MutedBrush">#FFA7ADB3</SolidColorBrush>
  <Style
    TargetType="ComboBoxItem"
    x:Key="{x:Type ComboBoxItem}">
    <Style.Resources>
      <ResourceDictionary />
    </Style.Resources>
    <Setter
      Property="TextElement.Foreground">
      <Setter.Value>
        <SolidColorBrush>#FFF4F5F7</SolidColorBrush>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Panel.Background">
      <Setter.Value>
        <SolidColorBrush>#00FFFFFF</SolidColorBrush>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Control.Padding">
      <Setter.Value>
        <Thickness>12,10,12,10</Thickness>
      </Setter.Value>
    </Setter>
    <Setter
      Property="Control.Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="ComboBoxItem">
          <Border
            Padding="{TemplateBinding Control.Padding}"
            CornerRadius="{StaticResource CompactCornerRadius}"
            Background="{TemplateBinding Panel.Background}"
            Name="ItemBorder">
            <ContentPresenter
              Content="{TemplateBinding ContentControl.Content}"
              ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
              ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="ComboBoxItem.IsHighlighted">
              <Setter
                Property="Panel.Background"
                TargetName="ItemBorder">
                <Setter.Value>
                  <SolidColorBrush>#FF20262B</SolidColorBrush>
                </Setter.Value>
              </Setter>
              <Trigger.Value>
                <s:Boolean>True</s:Boolean>
              </Trigger.Value>
            </Trigger>
            <Trigger
              Property="Selector.IsSelected">
              <Setter
                Property="Panel.Background"
                TargetName="ItemBorder">
                <Setter.Value>
                  <SolidColorBrush>#FF2B241E</SolidColorBrush>
                </Setter.Value>
              </Setter>
              <Trigger.Value>
                <s:Boolean>True</s:Boolean>
              </Trigger.Value>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
